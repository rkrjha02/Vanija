# Database (Neon) - use the DIRECT connection string, not the pooled one
# Change postgresql:// to postgresql+psycopg:// and ensure sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require

# Test database (separate Neon project or branch)
TEST_DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/testdb?sslmode=require

# Groq
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=model-name-here

# Embeddings (policy search). Create the key in Google AI Studio. NEVER enable Cloud Billing on its project.
GEMINI_API_KEY=your_gemini_key_here
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Auth / JWT
# A long random string used to sign access and refresh tokens.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use the SAME value locally and on Render — changing it invalidates every token.
JWT_SECRET_KEY=your-secret-key-here-change-this

# Admin login
# ADMIN_USERNAME: the username for the /admin login form (e.g. "admin").
# ADMIN_PASSWORD_HASH: a bcrypt hash of the admin password.
# Generate with:  python generate_password_hash.py "myAdminPassword"
# Paste the full $2b$12$... output here (keep the quotes in .env).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$examplehashhere

# CORS: comma-separated production origins (e.g. https://vanija.pages.dev)
# Local development origins (localhost:5173, localhost:3000) are always included.
ALLOWED_ORIGINS=
